# BankVision Frontend Environment Configuration Template
# Copy this file to .env and configure values for your local environment

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:8000/api

# Application Metadata
VITE_APP_NAME=BankVision
VITE_APP_ENV=development
VITE_APP_VERSION=1.0.0

# Production deployments should set VITE_API_BASE_URL to the reverse-proxy
# path that forwards to the Laravel API (for example, /api).
