# BankVision Frontend Production Environment

# Backend API Base URL. Configure the web server to proxy /api to the Laravel
# backend (for example, http://localhost:8000/api in a same-host deployment).
VITE_API_BASE_URL=/api

# Application Metadata
VITE_APP_NAME=BankVision
VITE_APP_ENV=production
VITE_APP_VERSION=1.0.0
